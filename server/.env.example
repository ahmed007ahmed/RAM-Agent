# Add real values in Railway Variables. Do not commit the actual secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
# Optional model APIs. Cloudflare remains default until RAM_AI_PROVIDER is changed.
RAM_AI_PROVIDER=cloudflare
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
# Gamma API can consume account credits when creating content.
GAMMA_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
# Optional: set TWILIO_CALLER_ID=anonymous to request withheld caller ID; carriers may reject/alter it.
TWILIO_TEST_TO=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
RAM_DATA_DIR=/data
